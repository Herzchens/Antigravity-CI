{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Herzchens/Antigravity-CI/schemas/agy-report.schema.json",
  "title": "Antigravity-CI review report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repo",
    "pr",
    "head_sha",
    "run_id",
    "generated_at",
    "result",
    "summary",
    "tests",
    "findings",
    "limitations",
    "tool_failures"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "pr": {
      "type": "integer",
      "minimum": 1
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "enum": [
        "passed",
        "changes_requested",
        "failed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/testResult"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "tool_failures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/toolFailure"
      }
    }
  },
  "$defs": {
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "title",
        "evidence"
      ],
      "properties": {
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "toolFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "error"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    }
  }
}
